set(VIETASR_MODEL_SOURCE_JSON "${CMAKE_CURRENT_LIST_DIR}/../src/modules/vietasr/models.json")
set(VIETASR_MODEL_SOURCE_TEMPLATE "${CMAKE_CURRENT_LIST_DIR}/model_source.h.in")
cmake_path(NORMAL_PATH VIETASR_MODEL_SOURCE_JSON)

set(VIETASR_MODEL_SOURCE_DIR "" CACHE PATH
    "Folder with encoder/decoder/joiner .int8.onnx + tokens.txt to embed instead of downloading from Hugging Face")

function(vietasr_model_source_read OUT_JSON)
    file(READ "${VIETASR_MODEL_SOURCE_JSON}" _json)
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${VIETASR_MODEL_SOURCE_JSON}")
    set(${OUT_JSON} "${_json}" PARENT_SCOPE)
endfunction()

function(vietasr_model_source_header OUT_INCLUDE_DIR)
    vietasr_model_source_read(_json)
    string(JSON VIETASR_MODEL_REPO GET "${_json}" "repo")
    string(JSON VIETASR_MODEL_REVISION GET "${_json}" "revision")
    string(JSON VIETASR_MODEL_BASE_URL GET "${_json}" "base_url")
    string(JSON _n LENGTH "${_json}" "files")
    math(EXPR _last "${_n} - 1")
    set(_entries "")
    foreach(_i RANGE ${_last})
        string(JSON _role GET "${_json}" "files" ${_i} "role")
        string(JSON _name GET "${_json}" "files" ${_i} "name")
        string(JSON _size GET "${_json}" "files" ${_i} "size")
        string(JSON _md5 GET "${_json}" "files" ${_i} "md5")
        string(APPEND _entries "    {\"${_role}\", \"${_name}\", ${_size}ULL, \"${_md5}\"},\n")
    endforeach()
    set(VIETASR_MODEL_FILE_ENTRIES "${_entries}")
    set(_out_dir "${CMAKE_BINARY_DIR}/generated")
    configure_file("${VIETASR_MODEL_SOURCE_TEMPLATE}" "${_out_dir}/vietasr_model_source.h" @ONLY)
    set(${OUT_INCLUDE_DIR} "${_out_dir}" PARENT_SCOPE)
endfunction()

function(vietasr_model_source_fetch OUT_DIR OUT_ROLES)
    vietasr_model_source_read(_json)
    string(JSON _revision GET "${_json}" "revision")
    string(JSON _base_url GET "${_json}" "base_url")
    string(SUBSTRING "${_revision}" 0 12 _short)
    if(VIETASR_MODEL_SOURCE_DIR)
        set(_dir "${VIETASR_MODEL_SOURCE_DIR}")
    else()
        set(_dir "${CMAKE_BINARY_DIR}/vietasr-model/${_short}")
    endif()
    file(MAKE_DIRECTORY "${_dir}")
    string(JSON _n LENGTH "${_json}" "files")
    math(EXPR _last "${_n} - 1")
    set(_roles "")
    foreach(_i RANGE ${_last})
        string(JSON _role GET "${_json}" "files" ${_i} "role")
        string(JSON _name GET "${_json}" "files" ${_i} "name")
        string(JSON _sha GET "${_json}" "files" ${_i} "sha256")
        set(_path "${_dir}/${_name}")
        set(_have OFF)
        if(EXISTS "${_path}")
            file(SHA256 "${_path}" _got)
            if(_got STREQUAL _sha)
                set(_have ON)
            elseif(VIETASR_MODEL_SOURCE_DIR)
                message(FATAL_ERROR "vietasr: ${_path} does not match the pinned model (sha256 ${_sha})")
            endif()
        endif()
        if(NOT _have)
            message(STATUS "vietasr: downloading ${_name} from ${_base_url}")
            file(DOWNLOAD "${_base_url}${_name}" "${_path}"
                EXPECTED_HASH SHA256=${_sha}
                TLS_VERIFY ON
                STATUS _status)
            list(GET _status 0 _code)
            if(NOT _code EQUAL 0)
                list(GET _status 1 _msg)
                file(REMOVE "${_path}")
                message(FATAL_ERROR "vietasr: download of ${_name} failed: ${_msg}. "
                    "Pass -DVIETASR_MODEL_SOURCE_DIR=<folder with the model files> to build offline.")
            endif()
        endif()
        set(VIETASR_MODEL_FILE_${_role} "${_path}" PARENT_SCOPE)
        list(APPEND _roles ${_role})
    endforeach()
    set(${OUT_DIR} "${_dir}" PARENT_SCOPE)
    set(${OUT_ROLES} "${_roles}" PARENT_SCOPE)
endfunction()
