#if defined(__APPLE__)
#  define VA_RODATA .const
#  define VA_SYM(name) _##name
#else
#  define VA_RODATA .section .rodata
#  define VA_SYM(name) name
#endif

    VA_RODATA
    .balign 64
    .global VA_SYM(vietasr_asr_encoder)
VA_SYM(vietasr_asr_encoder):
@VIETASR_ENCODER_INCBINS@
VA_SYM(vietasr_asr_encoder_end):

    .balign 64
    .global VA_SYM(vietasr_asr_decoder)
VA_SYM(vietasr_asr_decoder):
@VIETASR_DECODER_INCBINS@
VA_SYM(vietasr_asr_decoder_end):

    .balign 64
    .global VA_SYM(vietasr_asr_joiner)
VA_SYM(vietasr_asr_joiner):
@VIETASR_JOINER_INCBINS@
VA_SYM(vietasr_asr_joiner_end):

    .balign 16
    .global VA_SYM(vietasr_asr_tokens)
VA_SYM(vietasr_asr_tokens):
    .incbin "@VIETASR_TOKENS_PATH@"
VA_SYM(vietasr_asr_tokens_end):

    .balign 8
    .global VA_SYM(vietasr_asr_encoder_size)
VA_SYM(vietasr_asr_encoder_size):
    .quad VA_SYM(vietasr_asr_encoder_end) - VA_SYM(vietasr_asr_encoder)
    .global VA_SYM(vietasr_asr_decoder_size)
VA_SYM(vietasr_asr_decoder_size):
    .quad VA_SYM(vietasr_asr_decoder_end) - VA_SYM(vietasr_asr_decoder)
    .global VA_SYM(vietasr_asr_joiner_size)
VA_SYM(vietasr_asr_joiner_size):
    .quad VA_SYM(vietasr_asr_joiner_end) - VA_SYM(vietasr_asr_joiner)
    .global VA_SYM(vietasr_asr_tokens_size)
VA_SYM(vietasr_asr_tokens_size):
    .quad VA_SYM(vietasr_asr_tokens_end) - VA_SYM(vietasr_asr_tokens)

#if defined(__linux__) && defined(__ELF__)
    .section .note.GNU-stack,"",%progbits
#endif
