if(NOT MSVC)
    enable_language(ASM)
endif()

function(vietasr_collect_model_file MANIFEST_JSON INDEX CHUNK_DIR OUT_ROLE OUT_FILES)
    string(JSON _role GET "${MANIFEST_JSON}" "files" ${INDEX} "role")
    string(JSON _n LENGTH "${MANIFEST_JSON}" "files" ${INDEX} "chunks")
    if(_n LESS 1)
        message(FATAL_ERROR "chunks.json: ${_role} lists no chunks")
    endif()
    math(EXPR _last "${_n} - 1")
    set(_files "")
    foreach(_i RANGE ${_last})
        string(JSON _cname GET "${MANIFEST_JSON}" "files" ${INDEX} "chunks" ${_i} "name")
        string(JSON _csha GET "${MANIFEST_JSON}" "files" ${INDEX} "chunks" ${_i} "sha256")
        set(_cpath "${CHUNK_DIR}/${_cname}")
        if(NOT EXISTS "${_cpath}")
            message(FATAL_ERROR "model chunk missing: ${_cpath}")
        endif()
        file(SHA256 "${_cpath}" _got)
        if(NOT _got STREQUAL _csha)
            message(FATAL_ERROR "chunk ${_cname} sha256 mismatch")
        endif()
        list(APPEND _files "${_cpath}")
    endforeach()
    set(${OUT_ROLE} "${_role}" PARENT_SCOPE)
    set(${OUT_FILES} "${_files}" PARENT_SCOPE)
endfunction()

function(vietasr_embed_model OUT_SOURCES_VAR)
    set(_chunk_dir "${CMAKE_CURRENT_SOURCE_DIR}/../models/vietasr")
    cmake_path(NORMAL_PATH _chunk_dir)
    set(_manifest "${_chunk_dir}/chunks.json")
    set(_tokens "${_chunk_dir}/tokens.txt")
    if(NOT EXISTS "${_manifest}")
        message(FATAL_ERROR "VIETASR_EMBED_MODEL is ON but ${_manifest} is missing. Run scripts/split_model.py.")
    endif()
    if(NOT EXISTS "${_tokens}")
        message(FATAL_ERROR "VIETASR_EMBED_MODEL is ON but ${_tokens} is missing.")
    endif()

    file(READ "${_manifest}" _json)
    string(JSON _n_files LENGTH "${_json}" "files")
    math(EXPR _last "${_n_files} - 1")
    set(_all_files "")
    foreach(_i RANGE ${_last})
        vietasr_collect_model_file("${_json}" ${_i} "${_chunk_dir}" _role _files)
        set(_files_${_role} "${_files}")
        list(APPEND _all_files ${_files})
    endforeach()
    foreach(_required encoder decoder joiner)
        if(NOT DEFINED _files_${_required})
            message(FATAL_ERROR "chunks.json has no ${_required} entry")
        endif()
    endforeach()

    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${_manifest}")
    message(STATUS "vietasr: embedding transducer model (encoder/decoder/joiner) + tokens")

    set(_gen_dir "${CMAKE_BINARY_DIR}/embedded")
    file(MAKE_DIRECTORY "${_gen_dir}")
    set(VIETASR_TOKENS_PATH "${_tokens}")

    if(MSVC)
        set(_entries "")
        set(_base_encoder 100)
        set(_base_decoder 200)
        set(_base_joiner 300)
        foreach(_role encoder decoder joiner)
            set(_rid ${_base_${_role}})
            foreach(_f ${_files_${_role}})
                string(APPEND _entries "${_rid} RCDATA \"${_f}\"\n")
                math(EXPR _rid "${_rid} + 1")
            endforeach()
        endforeach()
        set(VIETASR_MODEL_RC_ENTRIES "${_entries}")
        set(_rc "${_gen_dir}/embedded_model.rc")
        configure_file("${CMAKE_CURRENT_SOURCE_DIR}/cmake/embedded_model.rc.in" "${_rc}" @ONLY)
        set_source_files_properties("${_rc}" PROPERTIES OBJECT_DEPENDS "${_all_files};${_tokens}")
        set(${OUT_SOURCES_VAR} "${_rc}" PARENT_SCOPE)
    else()
        foreach(_role encoder decoder joiner)
            set(_incbins "")
            foreach(_f ${_files_${_role}})
                string(APPEND _incbins "    .incbin \"${_f}\"\n")
            endforeach()
            string(TOUPPER "${_role}" _upper)
            set(VIETASR_${_upper}_INCBINS "${_incbins}")
        endforeach()
        set(_asm "${_gen_dir}/embedded_model.S")
        configure_file("${CMAKE_CURRENT_SOURCE_DIR}/cmake/embedded_model.S.in" "${_asm}" @ONLY)
        set_source_files_properties("${_asm}" PROPERTIES OBJECT_DEPENDS "${_all_files};${_tokens}")
        set(${OUT_SOURCES_VAR} "${_asm}" PARENT_SCOPE)
    endif()
endfunction()
