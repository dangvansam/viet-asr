if(NOT MSVC)
    enable_language(ASM)
endif()

include(${CMAKE_CURRENT_LIST_DIR}/ModelSource.cmake)

set(VIETASR_EMBED_TEMPLATE_DIR "${CMAKE_CURRENT_LIST_DIR}")

function(vietasr_embed_model OUT_SOURCES_VAR)
    vietasr_model_source_fetch(_dir _roles)
    foreach(_required encoder decoder joiner tokens)
        if(NOT DEFINED VIETASR_MODEL_FILE_${_required})
            message(FATAL_ERROR "vietasr: models.json has no ${_required} entry")
        endif()
    endforeach()
    message(STATUS "vietasr: embedding transducer model from ${_dir}")

    set(_gen_dir "${CMAKE_BINARY_DIR}/embedded")
    file(MAKE_DIRECTORY "${_gen_dir}")
    set(VIETASR_TOKENS_PATH "${VIETASR_MODEL_FILE_tokens}")
    set(_all_files "${VIETASR_MODEL_FILE_encoder};${VIETASR_MODEL_FILE_decoder};${VIETASR_MODEL_FILE_joiner};${VIETASR_MODEL_FILE_tokens}")

    if(MSVC)
        set(VIETASR_MODEL_RC_ENTRIES
            "1000 RCDATA \"${VIETASR_MODEL_FILE_encoder}\"\n1100 RCDATA \"${VIETASR_MODEL_FILE_decoder}\"\n1200 RCDATA \"${VIETASR_MODEL_FILE_joiner}\"\n")
        set(_out "${_gen_dir}/embedded_model.rc")
        configure_file("${VIETASR_EMBED_TEMPLATE_DIR}/embedded_model.rc.in" "${_out}" @ONLY)
    else()
        foreach(_role encoder decoder joiner)
            string(TOUPPER "${_role}" _upper)
            set(VIETASR_${_upper}_INCBINS "    .incbin \"${VIETASR_MODEL_FILE_${_role}}\"\n")
        endforeach()
        set(_out "${_gen_dir}/embedded_model.S")
        configure_file("${VIETASR_EMBED_TEMPLATE_DIR}/embedded_model.S.in" "${_out}" @ONLY)
    endif()
    set_source_files_properties("${_out}" PROPERTIES OBJECT_DEPENDS "${_all_files}")
    set(${OUT_SOURCES_VAR} "${_out}" PARENT_SCOPE)
endfunction()
