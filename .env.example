# Copy to .env and adjust. docker compose reads these.

# --- GPU (NVIDIA CDI; `nvidia-ctk cdi list` to see ids) ---
GPU_DEVICE=nvidia.com/gpu=0
FUNASR_GPU=nvidia.com/gpu=1     # Fun-ASR vLLM (Blackwell)
NEMOTRON_GPU=nvidia.com/gpu=1
QWEN_GPU=nvidia.com/gpu=1

# --- secrets ---
HF_TOKEN=                      # required for pyannote/segmentation-3.0 (gated)

# --- model cache (HuggingFace only; NOT ModelScope) ---
# Every model service bind-mounts this host dir at /root/.cache/huggingface and runs
# HF-offline (cache only). Pre-download all models here.
HF_CACHE_HOST=/data/samdv/.cache/huggingface
HF_OFFLINE=1                   # 1 = HF cache only (no network/ModelScope); 0 = allow download

# --- host-published ports (internal ports are fixed; avoid host conflicts e.g.
#     MinIO on 9001). These are only for host access; the pipeline uses the
#     internal service-name:port over the compose network regardless. ---
VAD_PORT=9401
ASR_FUNASR_PORT=9402
ALIGN_MMS_PORT=9403
ASR_NEMOTRON_PORT=9404
ASR_VIETASR_PORT=9104
ASR_QWEN3_PORT=8101
ALIGN_QWEN3_PORT=8103
SPEAKER_PORT=2010
GENDER_PORT=8000

# --- service URLs the pipeline talks to (compose network hostnames) ---
# All ASR services speak the OpenAI Audio API; the unified `openai_transcription`
# client appends /v1/audio/transcriptions, so these are base URLs (no path).
VAD_URL=http://vad:9001
ASR_URL=http://asr-funasr:9102          # Fun-ASR-MLT (vLLM)
QWEN_ASR_URL=http://asr-qwen3:8101      # Qwen3-ASR (vLLM)
NEMOTRON_URL=http://asr-nemotron:9103
VIETASR_URL=http://asr-vietasr:9104
ALIGN_URL=http://align-mms:9203
# speaker/gender are built+run in THIS compose (profile full, from their repo Dockerfiles).
# OpenAI-style: speaker POST /v1/audio/embeddings, gender POST /v1/audio/classifications.
# BASE urls (clients append the path). speaker needs the bundled MySQL (speaker-db).
EMBED_URL=http://speaker-embed:2000
GENDER_URL=http://gender:8000
# Build contexts (the repos provide only the Dockerfile; the service is defined here):
SPEAKER_REPO=/home/samdv/speaker-recognition
GENDER_REPO=/home/samdv/gender-classification-service

# --- model choices ---
VAD_BACKEND=silero
# gpu-memory-utilization = FRACTION OF TOTAL VRAM the vLLM process may reach. CAUTION:
# vLLM counts DEVICE-WIDE used memory (incl. OTHER services loading on the same GPU)
# against this budget, so on a SHARED GPU these must be larger than a single model needs
# or the engine crashes at init with "No available memory for cache blocks" (negative KV).
# Tuned for GPU1 = RTX PRO 6000 Blackwell (~95.6 GB total), verified under concurrent start:
#   FUNASR 0.12 ~= 11.5 GB (Fun-ASR-Nano: ~7.9 GB non-KV footprint + KV)
#   QWEN   0.20 ~= 19.1 GB (Qwen3-ASR-1.7B: ~8 GB footprint + headroom for co-resident models)
# 0.10 worked for qwen3 alone but went to -5.6 GB KV during `up --force-recreate` of all
# services at once. On a smaller GPU these fractions buy fewer GB — raise them.
FUNASR_MODEL=FunAudioLLM/Fun-ASR-MLT-Nano-2512
FUNASR_VLLM_MEM=0.12
FUNASR_MAX_LEN=4096            # vLLM KV-cache context cap; smaller = less GPU reserved
# Request-coalescing batcher (docker/funasr_serve_batched.py): the server merges
# concurrent clips into ONE vllm.LLM.generate([...]) call. BATCH_SIZE = max clips
# per batch; BATCH_WAIT_MS = how long to wait filling a batch before flushing.
FUNASR_BATCH_SIZE=8
FUNASR_BATCH_WAIT_MS=20
NEMOTRON_MODEL=nvidia/nemotron-3.5-asr-streaming-0.6b
QWEN_ASR_MODEL=Qwen/Qwen3-ASR-1.7B
QWEN_VLLM_MEM=0.20
QWEN_MAX_LEN=4096             # vLLM KV-cache context cap; smaller = less GPU reserved
QWEN_ALIGNER_MODEL=Qwen/Qwen3-ForcedAligner-0.6B

# --- pipeline ---
PIPELINE_CONFIG=configs/pipeline_crawl_services.yaml
DATA_DIR=/home/samdv/DATA/crawl-2026
