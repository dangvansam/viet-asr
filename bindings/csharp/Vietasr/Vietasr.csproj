<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>

    <PackageId>viet-asr</PackageId>
    <Version>0.1.0</Version>
    <Authors>vietasr contributors</Authors>
    <Description>Universal Vietnamese Speech AI SDK — .NET binding</Description>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/dangvansam/viet-asr</PackageProjectUrl>
    <RepositoryUrl>https://github.com/dangvansam/viet-asr</RepositoryUrl>
    <PackageTags>asr;speech-recognition;vietnamese;vietasr;offline;onnx</PackageTags>
    <!-- The ~67 MB native (ONNX model embedded) is downloaded by NativeLoader
         at first use, not packed into the .nupkg. -->
  </PropertyGroup>

</Project>
